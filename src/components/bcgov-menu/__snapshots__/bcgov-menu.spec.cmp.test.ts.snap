exports[`bcgov-menu > renders a menu inside bcgov-header 1`] = `
<bcgov-header class="bcgov-header hydrated" classname="bcgov-header">
  <header>
    <bcgov-menu label="Main navigation" class="is-desktop hydrated">
      <nav aria-label="Main navigation">
        <ul class="align-left">
          <li>
            <a href="test.html">
              Test
            </a>
          </li>
          <li class="active">
            <a active="" href="test2.html">
              <span>
                Adding span
              </span>
            </a>
          </li>
          <li>
            <a href="https://gov.bc.ca">
              Components
            </a>
            <button class="disclosure-toggle" type="button" aria-controls="components-submenu" aria-label="Toggle Components" aria-expanded="false"></button>
            <ul id="components-submenu" hidden="">
              <li>
                <a href="test3.html">
                  Test3
                </a>
              </li>
              <li>
                <a href="test4.html">
                  Test4
                </a>
              </li>
            </ul>
          </li>
          <li>
            <button class="disclosure-toggle has-label" type="button" aria-controls="styles-submenu" aria-expanded="false">
              Styles
            </button>
            <ul id="styles-submenu" hidden="">
              <li>
                <a href="style1.html">
                  Test3
                </a>
              </li>
              <li>
                <a href="style2.html">
                  Test4
                </a>
              </li>
            </ul>
          </li>
        </ul>
      </nav>
    </bcgov-menu>
  </header>
</bcgov-header>
`;

