exports[`bcgov-search > renders a search form with a button 1`] = `
<bcgov-search id="search-navigation-example" class="is-search-desktop bcgov-search hydrated">
  <div class="search-container">
    <form>
      <input type="search" placeholder="Search">
      <bcgov-button button-style="search-inline" class="bcgov-button hydrated">
        <button class="search-inline" type="submit">
          <span class="bcgov-svg-icon">
            <svg data-prefix="fas" data-icon="magnifying-glass" class="svg-inline--fa fa-magnifying-glass" role="img" viewBox="0 0 512 512" aria-hidden="true">
              <path fill="currentColor" d="M416 208c0 45.9-14.9 88.3-40 122.7L502.6 457.4c12.5 12.5 12.5 32.8 0 45.3s-32.8 12.5-45.3 0L330.7 376C296.3 401.1 253.9 416 208 416 93.1 416 0 322.9 0 208S93.1 0 208 0 416 93.1 416 208zM208 352a144 144 0 1 0 0-288 144 144 0 1 0 0 288z"></path>
            </svg>
          </span>
          <span class="bcgov-button-text">
            Search
          </span>
        </button>
      </bcgov-button>
    </form>
  </div>
</bcgov-search>
`;
