{
  "name": "@bcgov/web-components",
  "version": "2.0.0",
  "description": "BCGov Design System Web Components using Stencil JS",
  "repository": {
    "type": "git",
    "url": "https://github.com/bcgov/design-system-web-components"
  },
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/bcgov-web-component/bcgov-web-components.esm.js",
  "files": [
    "dist/",
    "dist/loader",
    "src/components",
    "src/styles"
    
  ],
  "scripts": {
    "build": "stencil build",
    "start": "stencil build --dev --watch --serve",
    "test": "stencil-test --prod",
    "test:watch": "stencil-test --prod --watch",
    "generate": "stencil generate"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@stencil/core": "^4.27.1 || ^5.0.0-0",
    "@stencil/sass": "^3.3.3",
    "@stencil/vitest": "^1.8.3",
    "@types/node": "^22.13.5",
    "@vitest/browser-playwright": "^4.0.0",
    "playwright": "^1.52.0",
    "vitest": "^4.0.0"
  },
  "license": "MIT"

}
